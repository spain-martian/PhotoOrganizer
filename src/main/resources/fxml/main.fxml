<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="900" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.photoOrganizer.controller.MainPageController">

    <VBox spacing="10">
        <HBox>
            <Button fx:id="startButton" onAction="#startAction" prefWidth="88"
                    styleClass="start-button, main-button" text="Load">
                <HBox.margin>
                    <Insets top="4.0"/>
                </HBox.margin>
            </Button>
            <HBox spacing="10" styleClass="hbox-button-group">
                <Button fx:id="prev1" disable="true" onAction="#prev1Action" prefWidth="87" styleClass="main-button"
                        text="Prev 1"/>
                <Button fx:id="prevp" disable="true" onAction="#prevPageAction" prefWidth="87"
                        styleClass="main-button" text="Prev Page"/>
                <Button fx:id="prev20" disable="true" onAction="#prev20Action" prefWidth="87"
                        styleClass="main-button" text="Prev 20"/>
                <Button fx:id="prev200" disable="true" onAction="#prev200Action" prefWidth="87"
                        styleClass="main-button" text="Prev 200"/>
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
                <HBox.margin>
                    <Insets left="15.0"/>
                </HBox.margin>
            </HBox>
            <HBox spacing="10" styleClass="hbox-button-group">
                <Button fx:id="next1" disable="true" onAction="#next1Action" prefWidth="87" styleClass="main-button"
                        text="Next 1"/>
                <Button fx:id="nextp" disable="true" onAction="#nextPageAction" prefWidth="87"
                        styleClass="main-button" text="Next Page"/>
                <Button fx:id="next20" disable="true" onAction="#next20Action" prefWidth="87"
                        styleClass="main-button" text="Next 20"/>
                <Button fx:id="next200" disable="true" onAction="#next200Action" prefWidth="87"
                        styleClass="main-button" text="Next 200"/>
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
                <HBox.margin>
                    <Insets left="15.0"/>
                </HBox.margin>
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="hbox-button-group">
                <Button fx:id="gotoButton" disable="true" onAction="#goAction" prefWidth="80"
                        styleClass="main-button" text="Goto"/>
                <TextField fx:id="gotoField" prefWidth="60"/>
                <HBox.margin>
                    <Insets left="15.0" right="6.0"/>
                </HBox.margin>
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
            </HBox>
            <Button fx:id="settingsButton" onAction="#settingsAction" styleClass="settings-button">
                <graphic>
                    <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                        <Image url="@../icons/icon-settings.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <padding>
                <Insets bottom="5.0" top="5.0"/>
            </padding>
        </HBox>

        <HBox spacing="10">
            <Label prefWidth="45" styleClass="main-label" text="N"/>
            <Label prefHeight="17.0" prefWidth="189.0" styleClass="main-label" text="Date / File Name"/>
            <Label prefWidth="100" styleClass="main-label" text="GPS"/>
            <Label styleClass="main-label" text="Image"/>
        </HBox>
        <ScrollPane hbarPolicy="NEVER" styleClass="bg-transparent" HBox.hgrow="ALWAYS">
            <VBox spacing="10">
                <fx:include fx:id="row1" source="row.fxml"/>
                <fx:include fx:id="row2" source="row.fxml"/>
                <fx:include fx:id="row3" source="row.fxml"/>
                <fx:include fx:id="row4" source="row.fxml"/>
                <fx:include fx:id="row5" source="row.fxml"/>
            </VBox>

        </ScrollPane>
        <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="6.0"/>
        </padding>
    </VBox>
    <Region styleClass="separator-h"/>
    <VBox prefWidth="360" spacing="5">
        <HBox spacing="5.0">
            <padding>
                <Insets left="10.0" top="5"/>
            </padding>
            <Label text="Display:"/>
            <Label fx:id="selectedModeLabel" text="All Media Files From Root, Including Subfolders"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="24" spacing="5.0">
            <padding>
                <Insets left="10.0" top="2"/>
            </padding>
            <Button fx:id="unselectButton" styleClass="unselect-button" text="X" visible="false"/>
            <Label fx:id="selectedFolderLabel" styleClass="font-bold"/>
        </HBox>
        <HBox fx:id="startingDateTitle" managed="false" spacing="5.0" visible="false">
            <padding>
                <Insets left="10.0"/>
            </padding>
            <Label text="Starting Date:"/>
            <Label fx:id="startingDateLabel"/>
        </HBox>
        <Region styleClass="separator-v"/>
        <StackPane>
            <HBox fx:id="headerBox" alignment="CENTER_LEFT" spacing="8">
                <padding>
                    <Insets left="10.0" right="10.0" top="5.0"/>
                </padding>
                <Label styleClass="font-bold" text="Destination Path"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="searchButton" styleClass="move-here-button">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <Image url="@../icons/icon-search.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
            <TextField fx:id="searchField" managed="false" promptText="Search folders..." visible="false">
                <StackPane.margin>
                    <Insets left="10.0" right="10.0"/>
                </StackPane.margin>
            </TextField>
        </StackPane>
        <VBox fx:id="parentFolders" spacing="5.0">
            <VBox.margin>
                <Insets left="10.0"/>
            </VBox.margin>
        </VBox>
        <Region styleClass="separator-v">
            <VBox.margin>
                <Insets top="5"/>
            </VBox.margin>
        </Region>
        <Label text="Select Destination Subfolder">
            <padding>
                <Insets left="10.0"/>
            </padding>
        </Label>
        <ScrollPane minHeight="642.0" styleClass="bg-transparent">
            <VBox fx:id="childFolders" spacing="5"/>
            <padding>
                <Insets bottom="5" left="10.0"/>
            </padding>
        </ScrollPane>
    </VBox>
</HBox>
